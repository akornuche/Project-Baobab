generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  role         String     @default("USER")
  reviews      Review[]
  guides       Guide[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Domain {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  description     String?
  order           Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  subdomains      Subdomain[]
  guides          Guide[]
}

model Subdomain {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  description     String?
  domainId        String
  order           Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  domain          Domain       @relation(fields: [domainId], references: [id])
  guides          Guide[]
}

model Guide {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  subtitle        String?
  description     String?
  content         String
  domainId        String
  subdomainId     String
  toolId          String?
  reviewerId      String?
  lastVerified    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  published       Boolean          @default(false)
  publishedAt     DateTime?
  isDeleted       Boolean          @default(false)
  
  domain          Domain           @relation(fields: [domainId], references: [id])
  subdomain       Subdomain        @relation(fields: [subdomainId], references: [id])
  tool            Tool?            @relation()
  reviewer        User?            @relation(fields: [reviewerId], references: [id])
  sources         GuideSource[]
  reviews         Review[]
  directoryListings DirectoryListing[]
}

model Tool {
  id              String    @id @default(cuid())
  guideId         String    @unique
  name            String
  type            String
  inputs          String
  outputs         String
  logic           String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  guide           Guide     @relation(fields: [guideId], references: [id])
}

model DirectoryListing {
  id              String    @id @default(cuid())
  name            String
  description     String?
  category        String
  address         String?
  state           String
  city            String
  phone           String?
  email           String?
  website         String?
  guideId         String?
  verified        Boolean   @default(false)
  premium         Boolean   @default(false)
  
  // Premium tier details
  premiumTier     String?   @default("free")  // free, basic, premium, enterprise
  premiumStartDate DateTime?
  premiumEndDate  DateTime?
  premiumAutoRenew Boolean  @default(true)
  
  // Rating and reviews
  rating          Float     @default(0.0)  // 0-5 stars
  reviewCount     Int       @default(0)
  
  // Listing metadata
  impressions     Int       @default(0)
  clicks          Int       @default(0)
  
  // Status
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isDeleted       Boolean   @default(false)
  
  // Relations
  guide           Guide?    @relation(fields: [guideId], references: [id])
  subscriptions   DirectorySubscription[]
  reviews         DirectoryReview[]
}

model DirectorySubscription {
  id              String    @id @default(cuid())
  listingId       String
  listing         DirectoryListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  tier            String    @default("free")  // free, basic, premium, enterprise
  startDate       DateTime
  endDate         DateTime
  autoRenew       Boolean   @default(true)
  
  // Payment tracking
  amountPaid      Float?    // Amount paid in NGN
  paymentStatus   String    @default("PENDING")  // PENDING, COMPLETED, FAILED, REFUNDED
  transactionId   String?   // Payment provider transaction ID
  invoiceUrl      String?   // Link to invoice
  
  // Cancellation
  cancelledAt     DateTime?
  cancellationReason String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DirectoryReview {
  id              String    @id @default(cuid())
  listingId       String
  listing         DirectoryListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  rating          Int       @default(5)  // 1-5 stars
  title           String?
  comment         String?
  reviewer        String?   // Optional reviewer name
  email           String?   // Optional reviewer email for notification
  
  verified        Boolean   @default(false)  // Verified purchaser
  helpful         Int       @default(0)  // Count of helpful votes
  
  status          String    @default("PENDING")  // PENDING, APPROVED, REJECTED
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GuideSource {
  id              String    @id @default(cuid())
  guideId         String
  url             String
  title           String?
  verified        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  
  guide           Guide     @relation(fields: [guideId], references: [id])
}

model Review {
  id              String       @id @default(cuid())
  guideId         String
  reviewerId      String
  status          String       @default("DRAFT")
  submittedAt     DateTime?
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  guide           Guide        @relation(fields: [guideId], references: [id])
  reviewer        User         @relation(fields: [reviewerId], references: [id])
}

model EmailSubscriber {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  subscribedAt    DateTime @default(now())
  unsubscribedAt  DateTime?
  isActive        Boolean  @default(true)
  source          String?  // Where they subscribed from
  confirmationToken String?  @unique
  confirmedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdCampaign {
  id              String     @id @default(cuid())
  title           String
  description     String?
  advertiserName  String
  advertiserEmail String?
  advertiserPhone String?
  advertiserUrl   String?
  
  // Campaign settings
  startDate       DateTime
  endDate         DateTime
  budget          Float?                // Total budget in NGN
  status          String     @default("DRAFT")  // DRAFT, ACTIVE, PAUSED, COMPLETED
  
  // Tracking
  totalImpressions Int        @default(0)
  totalClicks     Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  isDeleted       Boolean    @default(false)
  
  // Relations
  ads             Advertisement[]
}

model Advertisement {
  id              String     @id @default(cuid())
  campaignId      String
  campaign        AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  // Ad content
  title           String
  imageUrl        String?
  linkUrl         String?
  altText         String?
  
  // Ad placement
  zone            String     @default("content")  // header, sidebar, content, footer, infeed
  size            String     @default("medium_rectangle")  // leaderboard, medium_rectangle, skyscraper, square, half_page
  priority        Int        @default(0)  // Higher priority ads shown first
  
  // Performance tracking
  impressions     Int        @default(0)
  clicks          Int        @default(0)
  ctr             Float      @default(0.0)  // Click-through rate, auto-calculated
  
  // Status
  status          String     @default("ACTIVE")  // ACTIVE, PAUSED, COMPLETED
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  isDeleted       Boolean    @default(false)
  
  // Relations
  impressionEvents AdImpression[]
  clickEvents     AdClick[]
}

model AdImpression {
  id              String     @id @default(cuid())
  adId            String
  ad              Advertisement @relation(fields: [adId], references: [id], onDelete: Cascade)
  
  // Tracking info
  userAgent       String?
  referrer        String?
  ipHash          String?     // Hashed IP for privacy
  createdAt       DateTime   @default(now())
}

model AdClick {
  id              String     @id @default(cuid())
  adId            String
  ad              Advertisement @relation(fields: [adId], references: [id], onDelete: Cascade)
  
  // Tracking info
  userAgent       String?
  referrer        String?
  ipHash          String?     // Hashed IP for privacy
  createdAt       DateTime   @default(now())
}
